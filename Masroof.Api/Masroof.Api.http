@baseUrl = http://localhost:5142
@id = PUT_EXPENSE_ID_HERE

### Create expense
POST {{baseUrl}}/expenses
Content-Type: application/json

{
  "title": "Office internet",
  "amount": 450.50,
  "category": "Utilities",
  "date": "2026-11-12T00:00:00Z"
}

### List expenses
GET {{baseUrl}}/expenses

### Get expense by id
GET {{baseUrl}}/expenses/{{id}}

### Update expense
PUT {{baseUrl}}/expenses/{{id}}
Content-Type: application/json

{
  "title": "Office internet (Nov)",
  "amount": 500,
  "category": "Utilities",
  "currency": "EGP",
  "date": "2026-11-12T00:00:00Z"
}

### Delete expense
DELETE {{baseUrl}}/expenses/{{id}}
